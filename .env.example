# Required for your real inbox. Any Basic Auth username is accepted.
APP_PASSWORD=replace-with-a-long-unique-password
# Optional: enables the thinking partner. Email works without it.
OPENAI_API_KEY=
AI_MODEL=gpt-4o
PORT=8080
TZ=Europe/London
# Only true for a sample inbox. Disables authentication and all real mail/AI calls.
DEMO_MODE=false
# Optional Fernet key. If omitted, a key is generated in the persistent data volume.
# Back up the entire data volume, including credential.key, to retain account access.
# CREDENTIAL_KEY=
# Set true when running behind an HTTPS reverse proxy.
COOKIE_SECURE=false
