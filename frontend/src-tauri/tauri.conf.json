{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FocusMail",
  "version": "1.0.0",
  "identifier": "com.focusmail.desktop",
  "build": {
    "beforeDevCommand": "node ../scripts/prepare-desktop.mjs",
    "beforeBuildCommand": "node ../scripts/prepare-desktop.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A calmer inbox, one conversation at a time.",
    "externalBin": [
      "binaries/focusmail-backend"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
